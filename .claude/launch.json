{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-uvicorn",
      "runtimeExecutable": "torneos-backend/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["app.main:app", "--reload", "--app-dir", "torneos-backend"],
      "port": 8000
    },
    {
      "name": "frontend-next",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "torneos-web"],
      "port": 3000
    }
  ]
}
