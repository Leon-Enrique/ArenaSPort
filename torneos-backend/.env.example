# Local: SQLite para arrancar sin instalar nada
DATABASE_URL=sqlite:///./torneos.db

# Produccion (Railway): Postgres
# DATABASE_URL=postgresql+psycopg://usuario:pass@host:5432/torneos

DEBUG=true
RUN_SEED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth (Discord OAuth2 + JWT propio) ---
# Generar un secreto real: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-en-produccion-nunca-usar-este-valor-en-serio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Crear una app en https://discord.com/developers/applications,
# OAuth2 > agregar el redirect indicado abajo, copiar Client ID y Secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback

# Discord IDs (separados por coma) que arrancan con AMBOS niveles de
# organizador desde el primer login: operan el torneo Y pueden gestionar
# quién más es organizador (ver README, seccion "Gestión de organizadores").
# Sin esto nadie podria promoverse a organizador nunca.
# Tu Discord ID: activá "Modo desarrollador" en Discord > click derecho en
# tu perfil > "Copiar ID de usuario".
DISCORD_IDS_ORGANIZADORES_INICIALES=

# --- Evidencia (capturas de resultados y disputas) ---
# true en desarrollo local (guarda en disco, sin cuenta de Cloudflare).
# false en produccion (sube a R2 - ver variables R2_* abajo).
ALMACENAMIENTO_LOCAL=true
ALMACENAMIENTO_LOCAL_DIR=./evidencias

# Cloudflare R2 (solo si ALMACENAMIENTO_LOCAL=false):
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=torneos-evidencias
# R2_PUBLIC_BASE_URL=https://evidencias.tu-dominio.com
