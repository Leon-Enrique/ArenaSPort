# Plantilla de variables para PRODUCCION.
# Ver DESPLIEGUE.md para el paso a paso.
#
# Separada del .env.example de desarrollo a proposito: los defaults que hacen
# comodo desarrollar (DEBUG on, almacenamiento en disco, secreto de juguete)
# son justo los que no van en produccion.

# --- Base de datos ---
# NO la pongas a mano si usas Railway/Render: la inyectan solas.
# Llega como postgresql:// y la app la normaliza a postgresql+psycopg://
# al leerla (app/core/config.py), porque el proyecto usa psycopg 3.
# DATABASE_URL=postgresql://usuario:pass@host:5432/basededatos

# --- Obligatorias: sin esto el despliegue no sirve ---

# Generar uno nuevo:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Con el valor de ejemplo del repo, cualquiera que lo lea puede firmarse un
# token de organizador.
JWT_SECRET=

# Apaga /docs. En true queda la documentacion de la API abierta al publico.
DEBUG=false

# El dominio del frontend, separado por comas si hay mas de uno.
# Sin esto el navegador bloquea todas las llamadas y la web se ve vacia.
CORS_ORIGINS=https://tu-frontend.vercel.app

# Tu Discord ID. ES LA QUE MAS SE OLVIDA: sin esto no hay ningun organizador,
# nadie puede crear un torneo, y no se arregla desde la interfaz.
# Discord > Modo desarrollador > click derecho en tu perfil > Copiar ID.
DISCORD_IDS_ORGANIZADORES_INICIALES=

# Siembra el catalogo de juegos (hoy: solo Mobile Legends) en la base nueva.
# En false el catalogo queda vacio y no se puede crear ningun torneo.
RUN_SEED=true

# --- Evidencia de resultados ---
# En false las capturas van a Cloudflare R2. Dejarlo en true escribe en el
# disco del contenedor, que es efimero: las evidencias de las disputas se
# pierden en cada redeploy, justo cuando mas se necesitan.
ALMACENAMIENTO_LOCAL=false
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Discord OAuth (opcional) ---
# Hoy la web entra por email y contrasena; el boton de Discord todavia no
# esta en la interfaz. Si se activa, el redirect tiene que apuntar al dominio
# real, no a localhost.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://tu-backend/api/auth/discord/callback
